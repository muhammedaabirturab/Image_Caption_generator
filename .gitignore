# Virtual environment
venv/
env/
.venv/

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.pytest_cache/

# Raw Flickr8k dataset (~1GB of images, not ours to redistribute —
# see data/README.md for download instructions)
data/raw/

# Cached CNN feature vectors (large, easily regenerated by src/train.py;
# not needed for inference, only for re-running training/evaluation)
data/processed/image_features.pkl

# tokenizer.pkl and captions_clean.json ARE committed: they're small and
# the app needs tokenizer.pkl to run without a full local retrain.

# Trained model checkpoints ARE committed (see models/README.md) so the
# app works immediately after cloning, without requiring local training.

# Logs and temporary files
*.log
outputs/tmp/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
